# Postgres
POSTGRES_USER=srs_agent
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=srs_agent
DATABASE_URL=postgresql+asyncpg://srs_agent:change_me_dev_only@postgres:5432/srs_agent

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ROOT_USER=srs_agent_admin
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_ENDPOINT=minio:9000
# Left unset on purpose — presigned URLs are now signed against whatever
# host the browser used to reach the API itself, so this works from both
# localhost and the LAN IP without a fixed value. See assets.py.
# MINIO_PUBLIC_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=srs_agent_admin
MINIO_SECRET_KEY=change_me_dev_only
MINIO_SECURE=false

# App
APP_SECRET_KEY=a80ff81dec3925fdc4bdfefc590e8344637e710e5fa3d21be2e6e32577ca723e
PAT_ENCRYPTION_KEY=s78W4CDLSzmK6nraJTxmq0UOFS_kgiGby_b5fw3z7f8=
CORS_ORIGINS=http://localhost:3010,http://10.11.200.99:3010
AZURE_DEVOPS_API_VERSION=7.1

# Frontend
# Left unset on purpose — the frontend now derives the API's browser-facing
# address from whatever host the page itself was loaded from, so it works
# from both localhost and the LAN IP below without a separate build per
# access pattern. See apps/web/src/lib/api-base-url.ts.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
API_INTERNAL_URL=http://api:8000


# Local-disk mirror of every MinIO upload, used only as a download fallback
# if MinIO becomes unreachable. Not a replacement for object storage.
LOCAL_ASSET_FALLBACK_DIR=/data/local-assets

