# Postgres
POSTGRES_USER=srs_agent
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=srs_agent
DATABASE_URL=postgresql+asyncpg://srs_agent:change_me_dev_only@postgres:5432/srs_agent

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ROOT_USER=srs_agent_admin
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_ENDPOINT=minio:9000
# Advanced-deployment override only — left unset (the default), presigned
# download URLs are signed against whatever host the browser used to reach
# the API itself (see assets.py), on port 9020 (docker-compose's default
# MinIO S3-API port mapping). Only set this for a non-default port mapping,
# MinIO on a separate host, or a reverse proxy.
# MINIO_PUBLIC_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=srs_agent_admin
MINIO_SECRET_KEY=change_me_dev_only
MINIO_SECURE=false

# App
APP_SECRET_KEY=change_me_dev_only_generate_a_real_key
PAT_ENCRYPTION_KEY=change_me_dev_only_generate_a_fernet_key
# Every origin your BROWSER might actually load the frontend from —
# comma-separated, no trailing slash on any entry. The docker-compose
# default maps web's container port 3000 to host port 3010, so
# http://localhost:3010 must always be here; add every other host:port
# you'll open the app from too (e.g. a LAN IP so other devices on your
# network can reach it: http://192.168.1.20:3010). Missing an origin here
# doesn't error visibly — the browser silently blocks the request and the
# UI just hangs (e.g. stuck on "Checking session…").
CORS_ORIGINS=http://localhost:3010
AZURE_DEVOPS_API_VERSION=7.1

# Local-disk mirror of every MinIO upload, used only as a download fallback
# if MinIO becomes unreachable. Not a replacement for object storage.
LOCAL_ASSET_FALLBACK_DIR=/data/local-assets

# ─── LLM Provider ───────────────────────────────────────────────────────────
# Provider-neutral via litellm — MODEL_NAME's prefix selects the provider
# (e.g. "ollama/qwen3.5:4b", "gpt-4o", "azure/my-deployment"). Leave
# MODEL_NAME unset to disable AI enhancement entirely (document generation
# still works — the Introduction section just uses a deterministic default).
# Point this at your own Ollama instance (or another litellm-supported
# provider's base URL, if MODEL_NAME's prefix isn't "ollama/").
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=ollama/qwen3.5:4b
# Set to true to enable chain-of-thought / thinking tokens (Qwen3, etc.) —
# leave false unless you need the reasoning trace: it's ~5x slower and can
# exhaust a capped token budget before producing any actual output.
LLM_THINKING=false

# Frontend
# NEXT_PUBLIC_API_BASE_URL is baked into the browser bundle at build time —
# leave it UNSET (the default). The frontend then derives the API's
# address at runtime from whatever host the browser used to load the page
# itself, on port 8010 (docker-compose's default api port mapping) — this
# is what makes the app work whether you open it via localhost, a LAN IP,
# or a real domain, with no rebuild needed per access pattern. Only set
# this explicitly for advanced setups: a reverse proxy, a non-default api
# port mapping, or the API served from a genuinely different domain than
# the frontend.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# API_INTERNAL_URL is server-to-server only (Next.js server-side fetches) —
# it uses the Docker-network hostname and is unrelated to the
# browser-facing address above.
API_INTERNAL_URL=http://api:8000
